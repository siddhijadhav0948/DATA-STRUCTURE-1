#include <iostream>
#include <queue>
using namespace std;

int main() {
    queue<int> orders;
    int orderNumber;

    // Store 5 customer order numbers
    cout << "Enter 5 customer order numbers:" << endl;

    for (int i = 0; i < 5; i++) {
        cin >> orderNumber;
        orders.push(orderNumber);
    }

    // Process orders in the same order
    cout << "\nProcessing customer orders:" << endl;

    while (!orders.empty()) {
        cout << "Processing order number: "
             << orders.front() << endl;

        orders.pop();
    }

    return 0;
}
