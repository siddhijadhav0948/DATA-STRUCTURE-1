#include <iostream>
#include <queue>
using namespace std;

int main() {
    queue<int> tokens;
    int choice;
    int tokenNumber = 1;

    do {
        cout << "\n===== BANK TOKEN SYSTEM =====" << endl;
        cout << "1. Issue Token" << endl;
        cout << "2. Display Tokens" << endl;
        cout << "3. Serve Customer" << endl;
        cout << "4. Exit" << endl;
        cout << "Enter your choice: ";
        cin >> choice;

        switch (choice) {

            case 1:
                tokens.push(tokenNumber);
                cout << "Token issued: " << tokenNumber << endl;
                tokenNumber++;
                break;

            case 2:
                if (tokens.empty()) {
                    cout << "No customers waiting." << endl;
                } else {
                    queue<int> temp = tokens;

                    cout << "Waiting tokens: ";
                    while (!temp.empty()) {
                        cout << temp.front() << " ";
                        temp.pop();
                    }
                    cout << endl;
                }
                break;

            case 3:
                if (tokens.empty()) {
                    cout << "No customer to serve." << endl;
                } else {
                    cout << "Serving customer with token: "
                         << tokens.front() << endl;
                    tokens.pop();
                }
                break;

            case 4:
                cout << "Thank you! Exiting the program." << endl;
                break;

            default:
                cout << "Invalid choice. Please try again." << endl;
        }

    } while (choice != 4);

    return 0;
}
