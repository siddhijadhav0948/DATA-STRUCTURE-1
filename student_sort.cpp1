#include <iostream>
using namespace std;

int main() {
    const int MAX_STUDENTS = 100;
    int rollNumbers[MAX_STUDENTS];
    float marks[MAX_STUDENTS];
    int count = 0;
    int choice;
    
    do {
        cout << "\n--- Student Management System ---\n";
        cout << "1. Add Student (Roll No & Marks)\n";
        cout << "2. Display All Student Records\n";
        cout << "3. Search for Student by Roll No\n";
        cout << "4. Exit\n";
        cout << "Enter your choice: ";
        cin >> choice;
        
        switch(choice) {
            case 1:
                if(count < MAX_STUDENTS) {
                    cout << "Enter Roll Number: ";
                    cin >> rollNumbers[count];
                    cout << "Enter Marks: ";
                    cin >> marks[count];
                    count++;
                    cout << "Student added successfully!\n";
                } else {
                    cout << "Database is full!\n";
                }
                break;
                
            case 2:
                if(count == 0) {
                    cout << "No student records found.\n";
                } else {
                    cout << "\n--- Student Records ---\n";
                    for(int i = 0; i < count; i++) {
                        cout << "Roll No: " << rollNumbers[i] << " | Marks: " << marks[i] << endl;
                    }
                }
                break;
                
            case 3: {
                if(count == 0) {
                    cout << "No student records found.\n";
                    break;
                }
                int searchRoll;
                bool found = false;
                cout << "Enter Roll Number to search: ";
                cin >> searchRoll;
                for(int i = 0; i < count; i++) {
                    if(rollNumbers[i] == searchRoll) {
                        cout << "Student found! Roll No: " << rollNumbers[i] << " | Marks: " << marks[i] << endl;
                        found = true;
                        break;
                    }
                }
                if(!found) {
                    cout << "Student not found.\n";
                }
                break;
            }
                
            case 4:
                cout << "Exiting program...\n";
                break;
                
            default:
                cout << "Invalid choice! Please try again.\n";
        }
    } while(choice != 4);
    
    return 0;
}
